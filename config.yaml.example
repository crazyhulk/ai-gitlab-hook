server:
  host: "0.0.0.0"
  port: 8021

log:
  level: "INFO"       # DEBUG / INFO / WARNING / ERROR
  dir: "./logs"
  file: "gitlab-hook.log"

wechat:
  webhook_url: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_WECHAT_WEBHOOK_KEY"

gitlab:
  secret_token: "YOUR_GITLAB_WEBHOOK_SECRET"

main_branch: main        # 生产主干分支名，与 GITLAB_BRANCH_MAIN 保持一致
pre_branch: pre          # 预发布分支名，与 GITLAB_BRANCH_PRE 保持一致

tl_usernames:
  - your_tl_gitlab_username

hotfix_required_approvals: 2
frontend_review_path: "frontend-v1/"
frontend_required_reviewers:
  - yangzhengpeng01
  - wangqiyuan01
  - xuying13
hotfix_sync_threshold_hours: 4        # 热修合入 main 后超过此小时数未同步 pre 则告警
hotfix_sync_check_interval_seconds: 60    # 内部定时检查间隔（秒），默认每分钟一次

user_map:
  gitlab_username1: "1xxxxxxxxxx"
  gitlab_username2: "1xxxxxxxxxx"
